<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<LangVersion>Latest</LangVersion>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	</PropertyGroup>

	<PropertyGroup>
		<TheLongDarkPath>I:\SteamLibrary\steamapps\common\TheLongDark</TheLongDarkPath>
		<ModsPath>$(TheLongDarkPath)\Mods</ModsPath>
		<Il2CppAssembliesPath>$(TheLongDarkPath)\MelonLoader\Il2CppAssemblies</Il2CppAssembliesPath>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Unity\**" />
		<Compile Remove="PocLayered\**" />
		<EmbeddedResource Remove="Unity\**" />
		<EmbeddedResource Remove="PocLayered\**" />
		<None Remove="Unity\**" />
		<None Remove="PocLayered\**" />
	</ItemGroup>

	<!-- Map art ships as sidecar AssetBundles (preferred) or PNG zips (fallback), not embedded. -->
	<ItemGroup>
		<None Include="Maps\**\*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="LavaGang.MelonLoader" Version="0.7.2" />
		<!-- 2.55 NuGet for BCL-safe refs; Assembly-CSharp swapped to local 2.59 below. -->
		<PackageReference Include="STBlade.Modding.TLD.Il2CppAssemblies.Windows" Version="2.55.0" />
		<PackageReference Include="STBlade.Modding.TLD.ModSettings" Version="1.9.0" />
	</ItemGroup>

	<!-- Game is 2.59; NuGet tops at 2.55 which still has old FogOfWar sync API. -->
	<Target Name="UseLocalAssemblyCSharp" AfterTargets="ResolveAssemblyReferences">
		<ItemGroup>
			<ReferencePath Remove="@(ReferencePath)" Condition="'%(Filename)' == 'Assembly-CSharp'" />
			<ReferencePath Include="$(Il2CppAssembliesPath)\Assembly-CSharp.dll" />
		</ItemGroup>
	</Target>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(TheLongDarkPath)/Mods" />
	</Target>
</Project>
